---
import BaseLayout from '../layouts/BaseLayout.astro';
import articlesData from '../data/articles.json';

const resources = (articlesData as any[])
  .filter((p) => p.type === 'resource' || p.hot)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout title="资源">
  <main class="content">
    <h1 class="page-title">资源页</h1>
    <p class="page-sub">整理自顶级高校与公开会议的 PDF、实战与代码范例</p>

    <ul class="res-list">
      {resources.map((e) => (
        <li>
          <div class="info">
            <div class="t">{e.title}</div>
            {e.description && <div class="d">{e.description}</div>}
            <div class="d"><i class="far fa-calendar"></i> {e.date} · <i class="fas fa-folder"></i> {e.category}</div>
          </div>
          <a class="btn" href={`/articles/${e.id}`}>查看</a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
