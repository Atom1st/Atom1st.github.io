---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articlesData from '../../data/articles.json';
import { CATEGORIES, catClass } from '../../lib/categories';

const articles = (articlesData as any[])
  .filter((p) => p.type === 'article')
  .sort((a, b) => b.date.localeCompare(a.date));

---
<BaseLayout title="文章">
  <main class="content">
    <h1 class="page-title">文章</h1>
    <p class="page-sub">全部技术文章，按发布时间倒序排列</p>

    <div class="category-filters" id="categoryFilters">
      {CATEGORIES.map((cat) => (
        <a
          class={cat === '全部' ? 'active' : ''}
          data-category={cat === '全部' ? '' : cat}
        >
          {cat}
        </a>
      ))}
    </div>

    <p class="page-sub" id="categoryLabel" style="margin-top: 12px; color: var(--muted);">
      显示全部
    </p>

    <div class="card-group" id="articleList">
      {articles.map((e) => (
        <a class="card" data-category={e.category} href={`/articles/${e.id}`}>
          <h3>
            {e.title}
            {e.origin === 'original' ? (
              <span class="mark" title="原创">✍️</span>
            ) : (
              <span class="mark" title="搬运">🔁</span>
            )}
            {e.access === 'protected' && <span class="mark" title="加密">🔒</span>}
          </h3>
          {e.description && <p>{e.description}</p>}
          <div class="meta">
            <span class={`cat-chip ${catClass(e.category)}`}>{e.category}</span>
            &nbsp;· <i class="far fa-calendar"></i> {e.date}
          </div>
        </a>
      ))}
    </div>
  </main>

  <script is:inline>
    (function () {
      const filters = document.getElementById('categoryFilters');
      if (!filters) return;

      var selected = localStorage.getItem('articleCategory') || '';

      function apply(cat) {
        selected = cat;
        localStorage.setItem('articleCategory', cat);

        filters.querySelectorAll('a').forEach(function (a) {
          a.classList.toggle('active', a.getAttribute('data-category') === cat);
        });

        var label = document.getElementById('categoryLabel');
        if (label) label.textContent = cat ? '显示类别: ' + cat : '显示全部';

        document.querySelectorAll('#articleList .card').forEach(function (card) {
          if (!cat || card.getAttribute('data-category') === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      }

      filters.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          apply(a.getAttribute('data-category') || '');
        });
      });

      apply(selected);
    })();
  </script>
</BaseLayout>
