---
import BaseLayout from '../layouts/BaseLayout.astro';
import articlesData from '../data/articles.json';

const all = (articlesData as any[]).filter((p) => p.type !== 'page');
const latest = all
  .filter((p) => p.type === 'article')
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 5);
const hot = all
  .filter((p) => p.hot)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout>
  <main class="content">
    <h1 class="page-title">追求人工智能的至真至美</h1>
    <p class="page-sub">有组织、有顺序、低门槛的 AI 与数学学习资源站</p>

    <h2>本站简介</h2>
    <p>从 1956 年的达特茅斯会议，到今天 DeepSeek、ChatGPT 这样的大模型，AI 正以前所未有的加速度发展。它比物理、历史等传统学科年轻得多，却已在不到一个世纪里深刻改变了我们的生活，有学者将其繁荣称作"第四次工业革命"。</p>
    <p>本网站旨在提供有组织、有顺序、低门槛的学习资源，普惠全国 AI 小白（包括站长）。在这里你可以找到顶级高校的 PDF 讲义、有趣的代码范例，以及世界级研究成果的解读。</p>

    <h2>最新文章</h2>
    <div class="card-group">
      {latest.map((e) => (
        <a class="card" href={`/article/${e.id}`}>
          <div class="badges">
            <span class={`badge ${e.origin}`}>{e.origin === 'original' ? '原创' : '搬运'}</span>
            <span class={`badge ${e.access}`}>{e.access === 'public' ? '公共' : '受保护'}</span>
          </div>
          <h3>{e.title}</h3>
          {e.description && <p>{e.description}</p>}
          <div class="meta">
            <i class="far fa-calendar"></i> {e.date} · <i class="fas fa-folder"></i> {e.category}
          </div>
        </a>
      ))}
    </div>

    <h2>热门资源</h2>
    <ul class="res-list">
      {hot.map((e) => (
        <li>
          <div class="info">
            <div class="t">{e.title}</div>
            {e.description && <div class="d">{e.description}</div>}
          </div>
          <a class="btn" href={`/article/${e.id}`}>查看</a>
        </li>
      ))}
    </ul>

    <h2>快速导航</h2>
    <div class="card-group">
      <a class="card" href="/resources"><h3><i class="fas fa-folder-open"></i> 资源页</h3><p>下载与学习资料。</p></a>
      <a class="card" href="/articles"><h3><i class="fas fa-book-open"></i> 文章页</h3><p>全部技术文章。</p></a>
      <a class="card" href="/friends"><h3><i class="fas fa-link"></i> 友链</h3><p>朋友们的站点。</p></a>
      <a class="card" href="/about"><h3><i class="fas fa-user"></i> 关于</h3><p>站长与本站故事。</p></a>
      <a class="card" href="/guestbook"><h3><i class="fas fa-comments"></i> 留言板</h3><p>留下你的足迹。</p></a>
    </div>
  </main>
</BaseLayout>
