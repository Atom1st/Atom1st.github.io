---
import BaseLayout from '../layouts/BaseLayout.astro';
import articlesData from '../data/articles.json';
import { catClass } from '../lib/categories';

const all = (articlesData as any[]).filter((p) => p.type !== 'page');
const latest = all
  .filter((p) => p.type === 'article')
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 5);
const hot = all
  .filter((p) => p.hot)
  .sort((a, b) => b.date.localeCompare(a.date));
---
<BaseLayout showHero>
  <main class="content">
    <h1 class="page-title">路漫漫其修远兮</h1>
    <p class="page-sub">吾将上下而求索 —— 一个初中Oier的博客</p>

    <picture class="hero-banner">
      <source media="(prefers-color-scheme: dark)" srcset="/ghptnight.webp" type="image/webp" />
      <img
        src="/ghptlight.webp"
        alt="观海平台"
        width="1920"
        height="806"
        fetchpriority="high"
        decoding="async"
        data-theme-src="/ghptlight.webp"
        data-theme-src-dark="/ghptnight.webp"
        data-theme-fallback="/ghptlight.png"
        data-theme-fallback-dark="/ghptnight.png"
      />
    </picture>

    <h2>本站简介</h2>
    <p>站长 Guiyihan 是一名来自广东汕头的初中生，现就读于专注数学与物理的Q班？</p>
    <p>为了分享我自己的生活与思考，我搭建了这个博客。这个博客从前端到部署全部AI、不用手搓。</p>
    <p>如今，世界之变，时代之变，以前所未有的速度进行着。我希望我可以保持创新，用这个博客传递我的所思所想。</p>
    <h2>最新文章</h2>
    <div class="card-list">
      {latest.map((e) => (
        <a class={`card ${catClass(e.category)}`} href={`/articles/${e.id}`}>
          <h3>
            {e.title}
            {e.origin === 'original' ? (
              <i class="fas fa-pen-nib mark origin" title="原创"></i>
            ) : (
              <i class="fas fa-share mark repost" title="搬运"></i>
            )}
            {e.access === 'protected' && <i class="fas fa-lock mark lock" title="加密"></i>}
          </h3>
          {e.description && <p>{e.description}</p>}
          <div class="meta">
            <span class="cat-chip">{e.category}</span>
            &nbsp;· <i class="far fa-calendar"></i> {e.date}
          </div>
        </a>
      ))}
    </div>

    <h2>热门资源</h2>
    <ul class="res-list">
      {hot.map((e) => (
        <li>
          <div class="info">
            <div class="t">{e.title}</div>
            {e.description && <div class="d">{e.description}</div>}
          </div>
          <a class="btn" href={`/articles/${e.id}`}>查看</a>
        </li>
      ))}
    </ul>

    <h2>快速导航</h2>
    <div class="card-group">
      <a class="card" href="/resources"><h3><i class="fas fa-folder-open"></i> 资源页</h3><p>下载与学习资料。</p></a>
      <a class="card" href="/articles"><h3><i class="fas fa-book-open"></i> 文章页</h3><p>全部技术文章。</p></a>
      <a class="card" href="/friends"><h3><i class="fas fa-link"></i> 友链</h3><p>朋友们的站点。</p></a>
      <a class="card" href="/about"><h3><i class="fas fa-user"></i> 关于</h3><p>站长与本站故事。</p></a>
      <a class="card" href="/guestbook"><h3><i class="fas fa-comments"></i> 留言板</h3><p>留下你的足迹。</p></a>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  // 主页横幅跟随主题切换：手动点按钮或系统偏好变化时，同步替换 <img> 的图源
  (function () {
    const img = document.querySelector('.hero-banner img');
    if (!img) return;

    function swapForTheme(theme) {
      const isDark = theme === 'dark';
      const target = isDark ? img.dataset.themeSrcDark : img.dataset.themeSrc;
      if (target && !img.src.endsWith(target)) img.src = target;
      const hint = isDark ? img.dataset.themeFallbackDark : img.dataset.themeFallback;
      if (hint) img.dataset.fallback = hint;
    }

    function currentTheme() {
      return document.documentElement.getAttribute('data-theme') || 'light';
    }

    // 初始同步（顶栏脚本可能已抢先设置 data-theme）
    swapForTheme(currentTheme());

    // 监听 <html data-theme> 变化：用户切换、系统偏好变化都会走到这里
    new MutationObserver(() => swapForTheme(currentTheme())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    // 图片加载失败（如不支持 WebP）时回退到 PNG
    img.addEventListener('error', () => {
      const fallback =
        currentTheme() === 'dark' ? img.dataset.themeFallbackDark : img.dataset.themeFallback;
      if (fallback && !img.src.endsWith(fallback)) img.src = fallback;
    });
  })();
</script>
