---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Topbar from '../components/Topbar.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../site';

interface Props {
  title?: string;
  /** 该页面是否包含首屏横幅（主页为 true）：用于提前预加载对应主题的横幅图 */
  showHero?: boolean;
}
const { title, showHero = false } = Astro.props;
const pageTitle = title ? `${title} - ${site.title}` : site.title;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.5.2/css/all.min.css" />
  <link rel="icon" href="/my.jpg" type="image/jpg" />
    {showHero && (
      <script is:inline>
        // 在 CSS/JS 之前预加载横幅图：只加载当前主题那张，避免浪费带宽
        (function () {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved || (prefersDark ? 'dark' : 'light');
          const base = theme === 'dark' ? '/ghptnight' : '/ghptlight';
          const supportsWebp = (function () {
            try {
              return document.createElement('canvas').toDataURL('image/webp').indexOf('data:image/webp') === 0;
            } catch (e) {
              return false;
            }
          })();
          const link = document.createElement('link');
          link.rel = 'preload';
          link.as = 'image';
          link.href = base + (supportsWebp ? '.webp' : '.png');
          link.setAttribute('fetchpriority', 'high');
          document.head.appendChild(link);
        })();
      </script>
    )}
  </head>
  <body>
    <Topbar />
    <div class="layout">
      <Sidebar />
      <div class="overlay" id="overlay"></div>
      <slot />
    </div>
    <script is:inline>
      const t = document.getElementById('menuToggle');
      const s = document.getElementById('sidebar');
      const o = document.getElementById('overlay');
      t?.addEventListener('click', () => {
        s.classList.toggle('open');
        o.classList.toggle('show');
      });
      o?.addEventListener('click', () => {
        s.classList.remove('open');
        o.classList.remove('show');
      });
    </script>
  </body>
</html>
