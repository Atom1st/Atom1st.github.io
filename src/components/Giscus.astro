---
const giscus = {
  repo: 'Atom1st/Atom1st.github.io',
  repoId: 'R_kgDORAaOfQ',
  category: 'General',
  categoryId: 'DIC_kwDORAaOfc4DET8b',
};
---
<section id="comments">
  <h2>评论</h2>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
    id="giscus-script"
  ></script>
</section>

<script is:inline>
  const html = document.documentElement;

  function setGiscusTheme(theme) {
    const frame = document.querySelector('iframe.giscus-frame');
    if (frame) {
      frame.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
    }
  }

  function applyCurrentTheme() {
    const theme = html.getAttribute('data-theme') || 'light';
    setGiscusTheme(theme);
  }

  // 监听 iframe 加载完成，然后应用主题
  const giscusScript = document.getElementById('giscus-script');
  giscusScript?.addEventListener('load', () => {
    // 稍微延迟确保 iframe 完全初始化
    setTimeout(applyCurrentTheme, 100);
  });

  // 监听主题变化
  const observer = new MutationObserver(applyCurrentTheme);
  observer.observe(html, { attributes: true, attributeFilter: ['data-theme'] });
</script>
