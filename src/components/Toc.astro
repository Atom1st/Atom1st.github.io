---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<nav class="toc" aria-label="文章目录">
  <div class="toc-title">目录</div>
  {items.map((h) => (
    <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-l3' : ''} data-toc-link>{h.text}</a>
  ))}
</nav>

<script is:inline>
  (function () {
    const links = document.querySelectorAll('.toc a[data-toc-link]');
    if (!links.length) return;
    const targets = Array.from(links).map(function (a) {
      return document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
    });
    function update() {
      let active = 0;
      targets.forEach(function (el, i) {
        if (el && el.getBoundingClientRect().top <= 120) active = i;
      });
      links.forEach(function (a, i) {
        a.classList.toggle('active', i === active);
      });
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
