---
import { site } from '../site';

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---
<header class="topbar">
  <button class="menu-toggle" id="menuToggle"><i class="fas fa-bars"></i></button>
  <span class="site-title">{site.title}</span>
  <nav class="header-nav" aria-label="主导航">
    {site.nav.map((item) => (
      <a href={item.href} class={isActive(item.href) ? 'active' : ''}>{item.label}</a>
    ))}
  </nav>
  <button class="search-trigger" id="searchTrigger" aria-label="搜索文章">
    <i class="fas fa-magnifying-glass"></i><span>搜索</span><kbd>/</kbd>
  </button>
  <button type="button" class="palette-toggle" id="paletteToggle" aria-label="切换黑白 / 彩色主题" title="切换黑白 / 彩色主题">
    <i class="fas fa-circle-half-stroke"></i>
  </button>
  <div class="theme-switch" role="group" aria-label="主题模式">
    <button type="button" data-theme-value="light" aria-label="亮色主题"><i class="fas fa-sun"></i></button>
    <button type="button" data-theme-value="dark" aria-label="暗色主题"><i class="fas fa-moon"></i></button>
    <button type="button" data-theme-value="system" aria-label="跟随系统"><i class="fas fa-desktop"></i></button>
  </div>
  <div class="reading-progress" id="readingProgress"></div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('paletteToggle');
    if (!btn) return;

    function applyPalette(value) {
      const palette = value === 'color' ? 'color' : 'mono';
      localStorage.setItem('palette', palette);
      document.documentElement.setAttribute('data-palette', palette);
      const isMono = palette === 'mono';
      btn.classList.toggle('active', isMono);
      const label = isMono ? '切换到彩色主题' : '切换到黑白主题';
      btn.setAttribute('aria-label', label);
      btn.title = label;
    }

    applyPalette(document.documentElement.getAttribute('data-palette') || 'mono');
    btn.addEventListener('click', function () {
      applyPalette(document.documentElement.getAttribute('data-palette') === 'mono' ? 'color' : 'mono');
    });
  })();
</script>

<script is:inline>
  (function () {
    const html = document.documentElement;
    const buttons = document.querySelectorAll('.theme-switch button');
    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

    function resolveTheme(setting) {
      if (setting === 'system') return darkQuery.matches ? 'dark' : 'light';
      return setting;
    }

    function apply(setting) {
      localStorage.setItem('theme', setting);
      const actual = resolveTheme(setting);
      html.setAttribute('data-theme', actual);
      buttons.forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-theme-value') === setting);
      });
      const frame = document.querySelector('iframe.giscus-frame');
      if (frame) {
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: actual } } }, 'https://giscus.app');
      }
    }

    apply(localStorage.getItem('theme') || 'system');

    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        apply(b.getAttribute('data-theme-value'));
      });
    });

    darkQuery.addEventListener('change', function () {
      if ((localStorage.getItem('theme') || 'system') === 'system') apply('system');
    });
  })();
</script>
