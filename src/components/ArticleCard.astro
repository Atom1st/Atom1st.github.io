---
import type { CollectionEntry } from 'astro:content';
import { catClass } from '../lib/categories';
interface Props {
  entry: CollectionEntry<'posts'>;
}
const { entry } = Astro.props;
const fmt = entry.data.date.toISOString().slice(0, 10);
---
<a class={`card ${catClass(entry.data.category)}`} href={`/articles/${entry.id}`}>
  <h3>
    {entry.data.title}
    {entry.data.origin === 'original' ? (
      <i class="fas fa-pen-nib mark origin" title="原创"></i>
    ) : (
      <i class="fas fa-share mark repost" title="搬运"></i>
    )}
    {entry.data.access === 'protected' && <i class="fas fa-lock mark lock" title="加密"></i>}
  </h3>
  {entry.data.description && <p>{entry.data.description}</p>}
  <div class="meta">
    <span class="cat-chip">{entry.data.category}</span>
    &nbsp;· <i class="far fa-calendar"></i> {fmt}
  </div>
</a>
